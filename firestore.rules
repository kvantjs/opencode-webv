rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function ownsUser(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function ownsSession(sessionId) {
      return signedIn()
        && exists(/databases/$(database)/documents/sessions/$(sessionId))
        && get(/databases/$(database)/documents/sessions/$(sessionId)).data.userId == request.auth.uid;
    }

    match /users/{userId} {
      allow read, create, update, delete: if ownsUser(userId);
    }

    match /sessions/{sessionId} {
      allow read, delete: if ownsSession(sessionId);
      allow create: if signedIn() && request.resource.data.userId == request.auth.uid;
      allow update: if ownsSession(sessionId)
        && request.resource.data.userId == request.auth.uid;

      match /messages/{messageId} {
        allow read, delete: if ownsSession(sessionId);
        allow create, update: if ownsSession(sessionId)
          && request.resource.data.userId == request.auth.uid
          && request.resource.data.sessionId == sessionId;
      }
    }

    match /projects/{projectId} {
      allow read, delete: if signedIn()
        && resource.data.userId == request.auth.uid;
      allow create, update: if signedIn()
        && request.resource.data.userId == request.auth.uid;
    }
  }
}
