{
  "entities": {
    "Session": {
      "title": "Session",
      "description": "A web AI coding and assistant session",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique session identifier",
          "maxLength": 128
        },
        "userId": {
          "type": "string",
          "description": "User UID who owns this session",
          "maxLength": 128
        },
        "title": {
          "type": "string",
          "description": "Session title",
          "maxLength": 500
        },
        "agentMode": {
          "type": "string",
          "description": "Mode of the agent (unified, build, chat, review)",
          "maxLength": 64
        },
        "model": {
          "type": "string",
          "description": "Gemini model selected",
          "maxLength": 64
        },
        "directory": {
          "type": "string",
          "description": "Target workspace directory or project context",
          "maxLength": 512
        },
        "status": {
          "type": "string",
          "description": "Session status (active, idle, thinking, completed, error)",
          "maxLength": 32
        },
        "createdAt": {
          "type": "number",
          "description": "Timestamp created"
        },
        "updatedAt": {
          "type": "number",
          "description": "Timestamp updated"
        },
        "rawData": {
          "type": "string",
          "description": "Serialized session payload"
        }
      },
      "required": ["id", "userId", "title", "createdAt", "updatedAt"]
    },
    "Message": {
      "title": "Message",
      "description": "Chat message or agent reasoning and execution event",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique message identifier",
          "maxLength": 128
        },
        "sessionId": {
          "type": "string",
          "description": "Parent session identifier",
          "maxLength": 128
        },
        "userId": {
          "type": "string",
          "description": "User UID who sent or initiated this message",
          "maxLength": 128
        },
        "role": {
          "type": "string",
          "description": "Role of the message sender (user, assistant, system)",
          "enum": ["user", "assistant", "system"]
        },
        "content": {
          "type": "string",
          "description": "Rendered message content"
        },
        "thoughts": {
          "type": "string",
          "description": "Thinking reasoning process stream"
        },
        "status": {
          "type": "string",
          "description": "Status of the message",
          "maxLength": 32
        },
        "createdAt": {
          "type": "number",
          "description": "Timestamp created"
        },
        "rawMessage": {
          "type": "string",
          "description": "Serialized full message payload"
        }
      },
      "required": ["id", "sessionId", "userId", "role", "createdAt"]
    },
    "Project": {
      "title": "Project",
      "description": "Web project metadata and workspace config",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique project identifier",
          "maxLength": 128
        },
        "userId": {
          "type": "string",
          "description": "User UID who owns this project",
          "maxLength": 128
        },
        "name": {
          "type": "string",
          "description": "Project name",
          "maxLength": 200
        },
        "directory": {
          "type": "string",
          "description": "Project directory",
          "maxLength": 512
        },
        "createdAt": {
          "type": "number",
          "description": "Timestamp created"
        },
        "updatedAt": {
          "type": "number",
          "description": "Timestamp updated"
        }
      },
      "required": ["id", "userId", "name", "createdAt", "updatedAt"]
    },
    "UserProfile": {
      "title": "UserProfile",
      "description": "Authenticated user profile and sync settings",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "User UID",
          "maxLength": 128
        },
        "userId": {
          "type": "string",
          "description": "User UID matching auth.uid",
          "maxLength": 128
        },
        "email": {
          "type": "string",
          "description": "User email address",
          "maxLength": 256
        },
        "displayName": {
          "type": "string",
          "description": "User display name",
          "maxLength": 128
        },
        "photoURL": {
          "type": "string",
          "description": "User avatar URL",
          "maxLength": 1024
        },
        "createdAt": {
          "type": "number",
          "description": "Registration timestamp"
        },
        "updatedAt": {
          "type": "number",
          "description": "Last profile update timestamp"
        }
      },
      "required": ["id", "userId", "createdAt", "updatedAt"]
    }
  },
  "firestore": {
    "/sessions/{sessionId}": {
      "schema": "Session",
      "description": "Collection of user coding and chat sessions"
    },
    "/sessions/{sessionId}/messages/{messageId}": {
      "schema": "Message",
      "description": "Subcollection of messages and thought streams belonging to a session"
    },
    "/projects/{projectId}": {
      "schema": "Project",
      "description": "Collection of projects registered by users"
    },
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "Private user profiles containing account and sync metadata"
    }
  }
}
